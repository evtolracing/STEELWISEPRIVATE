# Copy to src/backend/.env for local development.
# On Vercel, set these in Project Settings > Environment Variables instead.

# Database (local Docker Postgres, or the Supabase pooler URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/steelwise"
# Direct (non-pooled) connection used by Prisma migrations on Supabase
DIRECT_URL=""

# Supabase (server side). Find these in Supabase > Project Settings > API.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Auth. Required in production: a random string of at least 32 characters,
# for example the output of: openssl rand -hex 48
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
# Optional separate signing key for partner API tokens (derived from JWT_SECRET if empty)
PARTNER_JWT_SECRET=""

# CORS: comma-separated browser origins allowed to call the API from another
# domain. Leave empty when the frontend and API share a domain (Vercel).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Limits (optional)
JSON_BODY_LIMIT="5mb"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# AI providers
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Text-to-speech
ELEVENLABS_API_KEY=""

# Server
PORT=3001
NODE_ENV=development

# ── Scheduled work and outside services (Phase 4) ─────────────────────────────
# The host calls GET /api/internal/tasks/run every few minutes with
# "Authorization: Bearer <CRON_SECRET>". It sends partner events that are waiting and
# clears old request keys. Without it, events are still sent right after each action,
# but a failed one is not tried again until someone opens Admin > Integrations and
# presses "Run now". Use a long random value. TASKS_SECRET is accepted as a second name.
CRON_SECRET=""
# Time limits for calls to outside services, in milliseconds. Leave blank for the defaults.
# SPEECH_TIMEOUT_MS=20000
# AI_TIMEOUT_MS=25000
# WEBHOOK_TIMEOUT_MS=10000
# OUTBOUND_BREAKER_REST_MS=30000
# A partner event that has waited longer than this is not sent on its own (default 72).
# WEBHOOK_MAX_AGE_HOURS=72
# Only for testing against a stand-in server. Leave blank in production.
# ELEVENLABS_BASE_URL=""
# DEEPSEEK_BASE_URL=""
