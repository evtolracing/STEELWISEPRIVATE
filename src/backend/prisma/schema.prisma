  fromLocation    Location           @relation(fields: [fromLocationId], references: [id])
  order           Order              @relation(fields: [orderId], references: [id])
  items           ShipmentItem[]
  stops           ShipmentStop[]
  dropTags        DropTag[]
  dropTagListings DropTagListing[]
