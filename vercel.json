{
  "version": 2,
  "installCommand": "cd src/backend && npm install --legacy-peer-deps && cd ../frontend && npm install --include=dev --legacy-peer-deps",
  "buildCommand": "node scripts/build.cjs",
  "outputDirectory": "src/frontend/dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "src/backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
