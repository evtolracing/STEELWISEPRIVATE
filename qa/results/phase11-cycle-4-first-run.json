    "customerJobsTraced": 500,
    "transactionsReconciled": 2000,
    "scenarios": 300
   },
   "capacity": {
    "requestsPerSecond": {
     "min": 40,
     "why": "the day modelled here needs about 40 requests a second at its peak level on this machine"
    }
   }
