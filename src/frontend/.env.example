# Copy to src/frontend/.env.local for local development.
# On Vercel, set these in Project Settings > Environment Variables.

# Demo mode skips login and signs everyone in as a demo admin.
# Only for demo deployments with no real data.
VITE_DEMO_MODE="false"

# Supabase (browser side, public anon key only)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Backend API base path. Leave unset: the app calls /api on its own domain,
# and in local development Vite proxies /api to http://localhost:3001.
# VITE_API_URL="/api"

# Mapbox public token (restrict it to your domains in the Mapbox dashboard)
VITE_MAPBOX_TOKEN="your-mapbox-token-here"
