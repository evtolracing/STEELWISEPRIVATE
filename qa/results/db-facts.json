 "checkConstraints": [
  {
   "table": "Coil",
   "name": "Coil_heat_and_grade_unless_supply",
   "kind": "check",
   "def": "CHECK (((form = 'SUPPLY'::\"ProductForm\") OR ((\"heatId\" IS NOT NULL) AND (\"gradeId\" IS NOT NULL))))"
  },
  {
   "table": "Coil",
   "name": "Coil_weights_not_negative",
   "kind": "check",
   "def": "CHECK ((((\"netWeightLb\" IS NULL) OR (\"netWeightLb\" >= (0)::numeric)) AND ((\"grossWeightLb\" IS NULL) OR (\"grossWeightLb\" >= (0)::numeric))))"
  },
  {
   "table": "DocumentCounter",
   "name": "DocumentCounter_lastNumber_check",
   "kind": "check",
   "def": "CHECK ((\"lastNumber\" >= 0))"
  },
  {
   "table": "Inventory",
   "name": "Inventory_balance_identity",
   "kind": "check",
   "def": "CHECK ((abs((\"qtyOnHand\" - (((\"qtyAvailable\" + \"qtyAllocated\") + \"qtyOnHold\") + \"qtyInTransit\"))) <= 0.0001))"
  },
  {
   "table": "Inventory",
   "name": "Inventory_qtyAllocated_not_negative",
   "kind": "check",
   "def": "CHECK ((\"qtyAllocated\" >= (0)::numeric))"
  },
  {
   "table": "Inventory",
   "name": "Inventory_qtyAvailable_not_negative",
   "kind": "check",
   "def": "CHECK ((\"qtyAvailable\" >= (0)::numeric))"
  },
  {
   "table": "Inventory",
   "name": "Inventory_qtyInTransit_not_negative",
   "kind": "check",
   "def": "CHECK ((\"qtyInTransit\" >= (0)::numeric))"
