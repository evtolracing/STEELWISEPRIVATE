model Document {
  id             String         @id @default(uuid())
  documentType   DocumentType
  documentNumber String?
  title          String?
  fileName       String
  fileType       String?
  fileSizeBytes  Int?
  storagePath    String
  checksum       String?
  extractedData  Json?
  isVerified     Boolean        @default(false)
  verifiedById   String?
  verifiedAt     DateTime?
  issueDate      DateTime?
  expiryDate     DateTime?
  ownerId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          Organization?  @relation(fields: [ownerId], references: [id])
  links          DocumentLink[]
  heats          Heat[]
}

model DocumentLink {
  id         String   @id @default(uuid())
  documentId String
  entityType String
  entityId   String
  linkType   String   @default("PRIMARY")
  createdAt  DateTime @default(now())
