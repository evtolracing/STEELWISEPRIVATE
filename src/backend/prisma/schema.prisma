// ============================================================================
// CUSTOMER ADDRESSES
// ============================================================================

// Ship-to, bill-to and other addresses for a customer or one of its divisions.
model Address {
  id             String       @id @default(uuid())
  organizationId String
  addressType    String       @default("SHIPPING") // SHIPPING, SHIP_TO, DELIVERY, BILLING, MAILING
  addressName    String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String       @default("USA")
  isPrimary      Boolean      @default(false)
  shared         Boolean      @default(false) // usable by every division of the parent
  allDivisions   Boolean      @default(false)
  usageCount     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, addressType])
}

// ============================================================================
// EXECUTIVE: SIMULATIONS, FORECAST SNAPSHOTS, DECISION LOG
// ============================================================================

model SimulationScenario {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdById String?
  status      String   @default("DRAFT") // DRAFT, READY, ARCHIVED
  changes     Json     @default("[]")
  baseline    Json?
  results     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model ForecastSnapshot {
  id          String   @id @default(uuid())
  category    String
  horizon     String // 1M, 3M, 6M, 12M
  createdById String?
  data        Json
  createdAt   DateTime @default(now())

  @@index([category, createdAt])
}

model ExecutiveDecision {
  id                String    @id @default(uuid())
  decisionNumber    String    @unique // DEC-2026-0047
  type              String
  title             String
  description       String?
  decisionMaker     String?
  role              String?
  status            String    @default("PENDING") // PENDING, APPROVED, EXECUTED, REJECTED, CANCELLED
  scenarioId        String?
  predictedOutcome  Json?
  actualOutcome     Json?
  variance          Json?
  conditions        Json      @default("[]")
  aiRecommendation  String?
  aiConfidence      Int?
  outcomeRecordedAt DateTime?
  decidedAt         DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([type, decidedAt])
  @@index([status])
}

// ============================================================================
// ORDERHUB INTAKE: contacts, RFQs, quotes, orders and jobs captured by the
// intake pipeline (email, phone, web, AI parsing). Lines are kept as JSON in
// the shape the OrderHub API returns.
// ============================================================================

model IntakeContact {
  id              String        @id @default(uuid())
  companyName     String?
  contactName     String?
  email           String?       @unique
  phone           String?
  billingAddress  String?
  shippingAddress String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rfqs            IntakeRfq[]
  quotes          IntakeQuote[]
  orders          IntakeOrder[]

  @@index([companyName])
}

model IntakeRfq {
  id               String        @id @default(uuid())
  contactId        String
  channel          String        @default("EMAIL")
  sourceRef        String?
  status           String        @default("NEW")
  requestedByName  String?
  requestedByEmail String?
  requestedDueDate String?
  lines            Json          @default("[]")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contact          IntakeContact @relation(fields: [contactId], references: [id])
  quotes           IntakeQuote[]

  @@index([status, createdAt])
}

model IntakeQuote {
  id         String        @id @default(uuid())
  rfqId      String?
  contactId  String
  status     String        @default("DRAFT")
  validUntil String?
  currency   String        @default("USD")
  lines      Json          @default("[]")
  totalPrice Decimal       @default(0) @db.Decimal(14, 2)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  rfq        IntakeRfq?    @relation(fields: [rfqId], references: [id])
  contact    IntakeContact @relation(fields: [contactId], references: [id])
  orders     IntakeOrder[]

  @@index([status])
}

model IntakeOrder {
  id                String         @id @default(uuid())
  contactId         String?
  quoteId           String?
  channel           String         @default("PHONE")
  status            String         @default("NEW")
  locationId        String         @default("LOC-001")
  division          String?
  requestedShipDate String?
  promiseDate       String?
  lines             Json           @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  contact           IntakeContact? @relation(fields: [contactId], references: [id])
  quote             IntakeQuote?   @relation(fields: [quoteId], references: [id])
  jobs              IntakeJob[]

  @@index([status, createdAt])
}

model IntakeJob {
  id          String      @id @default(uuid())
  orderId     String
  orderLineId String
  locationId  String
  division    String
  status      String      @default("PLANNING")
  // Material, dimensions and inherited specs, in the API's job shape.
  details     Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  order       IntakeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ============================================================================
// POS SESSIONS
// A counter session's state machine (current state, context, history),
// saved after every action so a session survives restarts and serverless
// cold starts.
// ============================================================================

model PosSession {
  id           String   @id
  userId       String?
  terminalId   String?
  currentState String
  status       String   @default("ACTIVE") // ACTIVE, ENDED
  version      Int      @default(1)
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, updatedAt])
}

// ============================================================================
// STOP-WORK AUTHORITY (SWA) EVENTS
// Used by /api/safety/stop-work. Filterable fields are columns; the rest of
// each record, in the shape the API returns, is kept in data.
// ============================================================================

model StopWorkEvent {
  id          String   @id
  eventNumber String   @unique
  status      String
  scopeType   String
  scopeId     String
  severity    String
  initiatedAt DateTime
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([initiatedAt])
}

model StopWorkAudit {
  id          String   @id
  eventId     String
  performedAt DateTime
  data        Json
  createdAt   DateTime @default(now())

  @@index([eventId, performedAt])
}

model StopWorkStep {
  id         String   @id
  eventId    String
  stepNumber Int
  status     String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([eventId])
}

model StopWorkEvidence {
  id        String   @id
  eventId   String
  data      Json
  createdAt DateTime @default(now())

  @@index([eventId])
}

// Dispatch division registry (METALS, PLASTICS, ...) used by work-center
// types and the dispatch screens.
model DispatchDivision {
  id        String   @id
  label     String
  color     String   @default("#666")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// ORDER PIPELINE RUNS
// One run of the lead-to-cash pipeline (/api/v1/pipeline). The full
// context (stage history, linked contact/RFQ/quote/order/jobs, AI
// recommendations) is kept in data.
// ============================================================================

model PipelineRun {
  id           String   @id
  currentStage String
  channel      String
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([currentStage])
  @@index([updatedAt])
}

/// Shop-floor and operations exception feed (scrap, QC holds, downtime, …).
model ExceptionEvent {
  id             String    @id
  type           String
  message        String
  severity       String    @default("INFO")
  locationId     String?
  workCenterId   String?
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  occurredAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([locationId, occurredAt])
  @@index([acknowledged, occurredAt])
}
