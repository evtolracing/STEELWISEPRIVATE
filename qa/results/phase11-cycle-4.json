 "thresholds": {
  "status": "PROPOSED, PENDING OWNER APPROVAL",
  "limits": {
   "latency": {
    "sign-in": {
     "p95": 1500,
     "p99": 2500,
     "why": "a password check is deliberately slow (bcrypt); a morning of sign-ins must still feel immediate"
    },
    "screen read (lists, dashboards, reports)": {
     "p95": 800,
     "p99": 1500,
     "why": "a list or a report opens in under a second"
    },
    "simple change (order, reservation, receipt, shipment, payment, shop step)": {
     "p95": 800,
     "p99": 1500,
     "why": "a save answers in under a second"
    },
    "dispatch with its invoice": {
     "p95": 2000,
     "p99": 4000,
     "why": "invoice numbers are never skipped or repeated (owner decision of 2026-11-13), so invoices are written one at a time company-wide; a dispatch may wait its turn"
    },
    "reconciliation of the books": {
     "p95": 5000,
     "p99": 10000,
     "why": "run by finance on demand and by the scheduled task, not on every screen"
    }
   },
   "reliability": {
    "serverErrors": {
     "max": 0,
     "why": "no request may end in a 5xx answer that was not a deliberate failure injection"
    },
    "failedTransactionsPercent": {
     "max": 0.5,
     "why": "of attempted business transactions, after the product's own \"busy, try again\" resends"
    },
    "deadlocks": {
     "max": 0,
     "why": "the database must never have to break a deadlock"
    }
   },
   "integrity": {
    "invariantViolations": {
     "max": 0,
     "why": "negative stock, double invoices, duplicate numbers, unbalanced entries, overpaid invoices"
    },
    "transactionsNotFoundInDatabase": {
     "max": 0,
     "why": "everything counted as completed must be found in the database and, where it posts, in the books"
    },
    "reconciliationDifference": {
     "max": 0,
     "why": "the books equal the records, to the cent; a difference is recorded, never adjusted away"
    }
   },
