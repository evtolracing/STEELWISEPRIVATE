    "jobsInFlight": 8,
    "p95": 2000,
    "why": "a dock gets its paperwork within two seconds on an ordinary day"
   },
   "capacity": {
    "requestsPerSecond": {
     "min": 40,
     "why": "the day modelled here needs about 40 requests a second at its peak level on this machine"
    }
   }
